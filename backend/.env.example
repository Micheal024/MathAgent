# Environment variables for Math Modeling Agent Backend
# Copy this file to .env and fill in your values

# LLM Configuration
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# Database
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mathagent

# Redis
REDIS_URL=redis://localhost:6379/0

# Sandbox
# provider: "opensandbox" (self-hosted), "e2b" (cloud), or "local" (dev fallback)
SANDBOX_PROVIDER=opensandbox
SANDBOX_OPENSANDBOX_DOMAIN=localhost:8080
SANDBOX_OPENSANDBOX_API_KEY=
SANDBOX_OPENSANDBOX_IMAGE=opensandbox/code-interpreter:v1.0.1
SANDBOX_E2B_API_KEY=
SANDBOX_TIMEOUT_SECONDS=30

# Auth
AUTH_SECRET_KEY=dev-secret-key-change-in-production

# App
APP_DEBUG=true
